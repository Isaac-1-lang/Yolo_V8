# Systemd Service File for Waste Classification App
# Place this file at: /etc/systemd/system/waste-classification.service

[Unit]
Description=Waste Classification Streamlit App
Documentation=https://github.com/your-repo/waste-classification
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/waste-classification
Environment=PATH=/opt/waste-classification/waste_classification_env/bin
Environment=PYTHONPATH=/opt/waste-classification
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=STREAMLIT_SERVER_ENABLE_CORS=false
Environment=STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# Main command
ExecStart=/opt/waste-classification/waste_classification_env/bin/streamlit run streamlit-detection-tracking\ -\ app/app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/waste-classification
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=waste-classification

[Install]
WantedBy=multi-user.target
